# Optional machine-local path template for existing operator scripts.
# The local.sh entry uses ~/.config/fastwam/deploy.yml for models and outputs.
# This file only defines paths; activate the FastWAM Python environment separately.
export FASTWAM_REPO=/path/to/FastWAM
export FASTWAM_CACHE_ROOT="${FASTWAM_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/fastwam}"
export FASTWAM_DEPLOYMENT_ROOT="${FASTWAM_DEPLOYMENT_ROOT:-$FASTWAM_CACHE_ROOT/deployment}"
export FASTWAM_RUN_ROOT="${FASTWAM_RUN_ROOT:-$FASTWAM_CACHE_ROOT/runs}"
export FASTWAM_DEPLOY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/fastwam/deploy.yml"
