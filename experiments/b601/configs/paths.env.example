# Copy outside the checkout, edit the dataset path, then source the copy.
# This file configures paths only; activate your Python environment separately.
export FASTWAM_CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/fastwam"
export FASTWAM_DATASET_ROOT=/path/to/prepared_ee_delta_dataset
export DIFFSYNTH_MODEL_BASE_PATH="$FASTWAM_CACHE_ROOT/checkpoints"
export FASTWAM_ACTION_BACKBONE="$DIFFSYNTH_MODEL_BASE_PATH/ActionDiT_linear_interp_Wan22_alphascale_1024hdim.pt"
export FASTWAM_TEXT_CACHE="$FASTWAM_CACHE_ROOT/text_embeds/b601"
export FASTWAM_RUN_ROOT="$FASTWAM_CACHE_ROOT/runs"
export FASTWAM_DEPLOYMENT_ROOT="$FASTWAM_CACHE_ROOT/deployment"

# Required only for full-state continuation:
# export FASTWAM_RESUME_RUN=/path/to/original/run
# export FASTWAM_RESUME_STEP=step_003235
